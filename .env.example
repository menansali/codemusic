# Anthropic API key for creative generation. Without it the pipeline uses the built-in
# offline storyboard library (still renders a full video).
ANTHROPIC_API_KEY=

# Optional: model used for storyboard generation (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: studio mark typed into the corner through the middle of the reel (overrides studio.json name).
BRAND_NAME=

# Optional: path to ffmpeg / ffprobe binaries (default: whatever is on PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Optional: render concurrency (default: 6)
RENDER_CONCURRENCY=

# Dashboard (npm run dashboard). Instagram values are written here by the dashboard's Settings page.
DASHBOARD_PORT=4400
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_TOKEN_SAVED_AT=
IG_TOKEN_EXPIRES_AT=
# Instagram API version (graph.instagram.com)
IG_API_VERSION=v27.0
# Whisper model for automatic lyric timing: small (fast) | medium (default, better for rap) | large-v3
ALIGN_MODEL=medium
# Optional: path to cloudflared (temporary public link Instagram downloads the video from)
CLOUDFLARED_PATH=
